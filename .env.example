# Copy to .env for local runs. In GitHub Actions, set these as repo Secrets / Variables.

# --- AI summaries (2-line description + key skills). Without it, rule-based summaries are used.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# --- LinkedIn Company Page posting
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_ORG_URN=urn:li:organization:00000000
LINKEDIN_API_VERSION=202509

# --- Optional: morning preview on your phone
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Branding shown on the images and caption
BRAND_NAME=Talent Bridge
BRAND_HANDLE=Follow TalentBridge for more opportunities
BRAND_HASHTAGS=#TalentBridge #hiring #ITjobs #jobs #India
BRAND_TAGLINE=Connecting talent with opportunity
# Optional logo file (png/jpg/svg) that replaces the text wordmark
BRAND_LOGO=
# Lines on the image, separated by |
BRAND_VALUES=People|Opportunities|Brighter tomorrows
BRAND_SCRIPT=Your|next opportunity|awaits
BRAND_FOOTER=More opportunities|a brighter future
SHOW_SUMMARY=true
SHOW_SKILLS=true

# --- Search tuning
JOB_LOCATION=India
JOBS_PER_BUCKET=5
CANDIDATES_PER_BUCKET=20
PAGES_PER_QUERY=2
REQUEST_DELAY_MS=1500

# Set to true to publish straight after generating when using `npm run daily`
AUTO_PUBLISH=false
